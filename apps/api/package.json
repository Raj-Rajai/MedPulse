{
  "name": "@medpulse/api",
  "version": "3.0.0",
  "main": "dist/main.js",
  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "@prisma/client": "^6.19.3",
    "@types/express": "^5.0.6",
    "@types/finalhandler": "^1.2.4",
    "@types/node": "^26.6.10",
    "@types/pdfkit": "^0.17.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "finalhandler": "^2.1.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3"
  }
}
